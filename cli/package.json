{
  "name": "@provena/cli",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "CLI for indexing repos into the Provena governed memory plane.",
  "bin": {
    "provena": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "provena",
    "memory",
    "cli",
    "codebase-index"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:smoke": "node tests/smoke.mjs",
    "test:discover": "node tests/discover.test.mjs",
    "test:chunk-typescript": "node tests/chunk-typescript.test.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}