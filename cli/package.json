{
  "name": "@provena/cli",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "CLI for indexing repos into the Provena governed memory plane.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayushozha/provena.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/ayushozha/provena/issues"
  },
  "homepage": "https://github.com/ayushozha/provena/tree/main/cli#readme",
  "bin": {
    "provena": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "provena",
    "memory",
    "cli",
    "codebase-index"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node tests/smoke.mjs && node tests/config.test.mjs && node tests/build-artifacts.test.mjs && node tests/cli-behavior.test.mjs && node tests/pack.test.mjs && node tests/pack-install.test.mjs && node tests/security.test.mjs && node tests/discover.test.mjs && node tests/chunk-typescript.test.mjs && node tests/emit.integration.mjs && node tests/relations.test.mjs && node tests/index.e2e.mjs && node tests/incremental.test.mjs && node tests/watch.test.mjs && node tests/search.test.mjs && node tests/index.concurrency.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:discover": "node tests/discover.test.mjs",
    "test:chunk-typescript": "node tests/chunk-typescript.test.mjs",
    "test:emit": "npm run build && node tests/emit.integration.mjs",
    "test:index-e2e": "npm run build && node tests/index.e2e.mjs",
    "test:search": "npm run build && node tests/search.test.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
