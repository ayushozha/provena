# Copy this file to .env, replace every blank credential through a secret
# manager, and keep .env untracked. These defaults fail closed for production.
PROVENA_ENVIRONMENT=production
PROVENA_ALLOW_UNAUTHENTICATED_LOCAL=false

# Choose one store backend. PROVENA_DATABASE_URL takes precedence when both are
# set. /data/provena.db is the persistent path inside the shipped container.
PROVENA_DB_PATH=/data/provena.db
PROVENA_DATABASE_URL=

# External gateway authentication. PROVENA_API_KEYS is a JSON array containing
# SHA-256 key digests, never raw external bearer tokens.
PROVENA_AUTH_ENABLED=true
PROVENA_API_KEYS=[]

# Store and tenant-dedicated queue service authentication. The queue keeps this
# bearer only in process memory and injects it at intelligence dispatch.
# Set token, tenant, and principal together for production or whenever direct
# store or queue service authentication is enabled.
PROVENA_SERVICE_TOKEN=
PROVENA_SERVICE_TENANT_ID=
PROVENA_SERVICE_PRINCIPAL_ID=neverzero-coordination-worker
PROVENA_SERVICE_ROLE=editor
# Private gateway-to-service transport bearer used by store and lifecycle
# ingress. Keep it distinct from every raw external PROVENA_API_KEYS bearer
# and from tenant service credentials.
PROVENA_GATEWAY_SERVICE_TOKEN=
# Optional multi-tenant alternative. Each token_sha256 is a digest of a
# high-entropy bearer token; never place the raw token in this JSON.
PROVENA_SERVICE_IDENTITIES=[]

# Queue callers authenticate with this ingress-only bearer. It must differ from
# PROVENA_SERVICE_TOKEN, which remains the queue's process-owned downstream identity.
PROVENA_QUEUE_INGRESS_TOKEN=

# One lifecycle process owns one tenant. Register the SHA-256 digest of this
# raw token in PROVENA_SERVICE_IDENTITIES with the same tenant/principal and
# role "admin"; the lifecycle process never accepts a caller-selected tenant.
PROVENA_LIFECYCLE_SERVICE_TOKEN=
PROVENA_LIFECYCLE_TENANT_ID=
PROVENA_LIFECYCLE_PRINCIPAL_ID=provena-lifecycle

# Private cross-project Compose network. Create it once before either stack.
PROVENA_INTEGRATION_NETWORK=neverzero-provena

# Compose maps the common environment/bypass, gateway token, and tenant service
# identity above into the intelligence service's PROVENA_INTEL_* auth settings.
# A directly deployed intelligence process must set those prefixed equivalents.
PROVENA_INTEL_ENVIRONMENT=production
PROVENA_INTEL_ALLOW_UNAUTHENTICATED_LOCAL=false
PROVENA_INTEL_GATEWAY_SERVICE_TOKEN=
PROVENA_INTEL_SERVICE_TOKEN=
PROVENA_INTEL_SERVICE_TENANT_ID=
PROVENA_INTEL_SERVICE_PRINCIPAL_ID=
PROVENA_INTEL_SERVICE_ROLE=editor

# All published Compose ports bind loopback unless an operator explicitly
# changes the matching host address. Keep MCP private unless gateway auth and
# an external network policy protect it.
PROVENA_ORCHESTRATION_HOST_BIND=127.0.0.1
PROVENA_GATEWAY_HOST_BIND=127.0.0.1
PROVENA_MCP_HOST_BIND=127.0.0.1
PROVENA_QUEUE_HOST_BIND=127.0.0.1
PROVENA_LIFECYCLE_HOST_BIND=127.0.0.1
PROVENA_INTELLIGENCE_HOST_BIND=127.0.0.1

# Intelligence model selection (set MODEL to the id served by your endpoint)
PROVENA_INTEL_EMBEDDING_PROVIDER=local
PROVENA_INTEL_EMBEDDING_MODEL=
# From Compose, host.docker.internal reaches an operator-managed local endpoint.
PROVENA_INTEL_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
PROVENA_INTEL_EMBEDDING_API_KEY=
PROVENA_INTEL_EMBEDDING_DIMENSIONS=768

# Optional LLM-backed stages; leave MODEL empty to use deterministic heuristics
PROVENA_INTEL_LLM_MODEL=
PROVENA_INTEL_LLM_BASE_URL=http://host.docker.internal:11434/v1
PROVENA_INTEL_LLM_API_KEY=
PROVENA_INTEL_LLM_PROVIDERS=
PROVENA_INTEL_MODEL_ROUTER_DEFAULT_TIER=balanced
